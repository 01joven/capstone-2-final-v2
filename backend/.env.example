PORT=5000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long

# Frontend origins allowed to call the API (comma-separated).
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Resend is required for self-service password reset codes.
# Get an API key at https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxxxxxxx
# RESEND_FROM_EMAIL=Memorial Records <noreply@yourdomain.com>

# Local development only: seeds an admin account when the local database has none.
# Must be at least 12 characters. Nothing is seeded if this is unset.
# ADMIN_SEED_PASSWORD=change-me-to-a-long-passphrase
# ADMIN_SEED_EMAIL=admin@cemetery.gov

# Uncomment and replace this with your real Neon URL to use Neon instead of the local database.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Set to false only if your provider's TLS certificate cannot be verified.
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Set DATABASE_SSL=true to force TLS even when the URL has no ?sslmode=require.
# DATABASE_SSL=true

# App timezone for date handling (used for Manila reservation dates).
# APP_TIMEZONE=Asia/Manila
# Set NODE_ENV=production on hosted servers (refuses embedded DB, enforces TLS + secrets).
# NODE_ENV=production
# Set SEED_ADMIN=true only if you intentionally want admin seeding on a non-local DB.
# SEED_ADMIN=false
