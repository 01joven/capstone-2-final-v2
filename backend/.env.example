PORT=5000
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long

# Gmail SMTP for one-time admin registration email verification.
# Create a Google App Password (not your regular Gmail password).
# Use either SMTP_APP_PASSWORD or SMTP_PASS; keep only one active value.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@gmail.com
SMTP_APP_PASSWORD=your-16-character-google-app-password
SMTP_FROM=your-gmail-address@gmail.com

# Uncomment and replace this with your real Neon URL to use Neon instead of the local database.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
